# =========================================================
# Configuracion de entorno — API (apps/api)
# Copia este archivo a ".env" y ajusta los valores.
# El .env real NO se commitea (esta en .gitignore de la raiz).
#
# Las marcadas [OBLIGATORIA] se validan al arrancar (src/env.validation.ts):
# si falta o no cumple, la API NO arranca.
# =========================================================

# --- Servidor ---
# PORT: opcional, entero 1-65535 (por defecto 3000).
PORT=3000
# NODE_ENV: opcional, uno de development | production | test.
NODE_ENV=development

# --- Conexion a PostgreSQL (Prisma) ---
# [OBLIGATORIA] Debe coincidir con las credenciales del docker-compose de la raiz.
DATABASE_URL="postgresql://dtnotes:dtnotes_dev_password@localhost:5432/dtnotes?schema=public"

# --- Autenticacion (JWT) ---
# [OBLIGATORIA] Minimo 32 caracteres. No reutilices el valor de ejemplo.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# JWT_EXPIRES_IN: opcional (por defecto 1d). Ejemplos: 1d, 12h, 3600s.
JWT_EXPIRES_IN="1d"

# --- (Se iran anadiendo en fases posteriores) ---
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./storage
