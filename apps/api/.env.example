# =========================================================
# Configuracion de entorno — API (apps/api)
# Copia este archivo a ".env" y ajusta los valores.
# El .env real NO se commitea (esta en .gitignore de la raiz).
# =========================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Conexion a PostgreSQL (Prisma) ---
# Debe coincidir con las credenciales del docker-compose de la raiz.
DATABASE_URL="postgresql://dtnotes:dtnotes_dev_password@localhost:5432/dtnotes?schema=public"

# --- Autenticacion (JWT) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"

# --- (Se iran anadiendo en fases posteriores) ---
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./storage
