# =========================================================
# Configuracion de entorno — API (apps/api)
# Copia este archivo a ".env" y ajusta los valores.
# El .env real NO se commitea (esta en .gitignore de la raiz).
#
# Las marcadas [OBLIGATORIA] se validan al arrancar (src/env.validation.ts):
# si falta o no cumple, la API NO arranca.
# =========================================================

# --- Servidor ---
# PORT: opcional, entero 1-65535 (por defecto 3000).
PORT=3000
# NODE_ENV: opcional, uno de development | production | test.
NODE_ENV=development

# --- Conexion a PostgreSQL (Prisma) ---
# [OBLIGATORIA] Debe coincidir con las credenciales del docker-compose de la raiz.
DATABASE_URL="postgresql://dtnotes:dtnotes_dev_password@localhost:5432/dtnotes?schema=public"

# --- Autenticacion (JWT) ---
# [OBLIGATORIA] Minimo 32 caracteres. No reutilices el valor de ejemplo.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# JWT_EXPIRES_IN: opcional (por defecto 1d). Ejemplos: 1d, 12h, 3600s.
JWT_EXPIRES_IN="1d"

# --- CORS ---
# Origenes del navegador autorizados, separados por comas y SIN barra final.
# Opcional en desarrollo: si la omites se permiten http://localhost:5173 y
# http://127.0.0.1:5173 (el SPA de Vite).
# [OBLIGATORIA si NODE_ENV=production] Ejemplo: https://notes.midominio.com
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Rate limiting de autenticacion ---
# Todas opcionales; los TTL van en SEGUNDOS. Si las omites se usan estos valores.
# Login: 5 intentos por minuto. Registro: 3 altas por hora.
# THROTTLE_LOGIN_LIMIT=5
# THROTTLE_LOGIN_TTL=60
# THROTTLE_REGISTER_LIMIT=3
# THROTTLE_REGISTER_TTL=3600

# --- Papelera ---
# Dias que un documento o una carpeta aguanta en la papelera antes de que la
# tarea diaria (03:00) lo borre definitivamente. Opcional; por defecto 30.
# Es un plazo de instalacion: mas adelante cada usuario podra fijar el suyo
# desde la seccion de Configuracion.
# TRASH_RETENTION_DAYS=30

# --- (Se iran anadiendo en fases posteriores) ---
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./storage
