# =========================================================
# Configuracion de entorno — DTNotes (RAIZ)
# Copia este archivo a ".env" y ajusta los valores.
# El .env real NO se commitea (esta en .gitignore).
# =========================================================

# --- PostgreSQL (contenedor Docker de docker-compose.yml) ---
POSTGRES_USER=dtnotes
POSTGRES_PASSWORD=dtnotes_dev_password
POSTGRES_DB=dtnotes
POSTGRES_PORT=5432

# La cadena de conexion de la app (DATABASE_URL) vive en apps/api/.env
# (ver apps/api/.env.example) y debe coincidir con las credenciales de arriba.
